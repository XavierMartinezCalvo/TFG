  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 41f9504b98f90a34393f6e46c1cc7c06, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textos:
    arrayTextos:
    - "Nunca olvidar\xE9 la vez que desaparec\xED para poder proteger a Catson entre
      otros."
    - Tuve que huir para que ellos estuvieran a salvo de Foxiarty.
    - "Al cabo de 3 a\xF1os volv\xED a casa, donde a Catson casi le da un infarto
      al verme."
    - "Se qued\xF3 en shock, pero al final mi iron\xEDa ayud\xF3 a recomponerse y
      a re\xEDrse de la situaci\xF3n."
    - "Me apena no haber podido salvarte una vez m\xE1s Catson..."
  cuadroDialogo: {fileID: 152370136}
  alertaCuadro: {fileID: 295443581}
  encontrada: 0
  fuenteSonido: {fileID: 801468151}
