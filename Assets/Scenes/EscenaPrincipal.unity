  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 41f9504b98f90a34393f6e46c1cc7c06, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textos:
    arrayTextos:
    - "As\xED que en este bosque tambi\xE9n crecen setas, cuanto menos interesante..."
    - "Puede que Catson pasara por aqu\xED en una b\xFAsqueda de comida."
    - 'Lo que me genera duda es si alguna de estas setas pudiera ser venenosa. '
    - "Al menos la del tronco tengo claro que puede producir alguna alucinaci\xF3n."
    - Solo espero que Catson no se haya puesto a jugar con estas setas sin saber
      siquiera que efectos tienen.
  cuadroDialogo: {fileID: 152370136}
  alertaCuadro: {fileID: 0}
  encontrada: 0
  fuenteSonido: {fileID: 0}
